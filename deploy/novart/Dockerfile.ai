FROM rust:1.85.1-bookworm AS receipts
WORKDIR /build
COPY apps/native-model/src/lib.rs apps/native-model/src/disk.rs ./
RUN rustc --edition=2021 --crate-type cdylib -C opt-level=2 lib.rs -o libdeepflare_image_receipts.so

FROM python:3.12-slim
WORKDIR /app
COPY apps/ai/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY apps/ai/app ./app
COPY --from=receipts /build/libdeepflare_image_receipts.so /usr/local/lib/libdeepflare_image_receipts.so
ENV DEEPFLARE_NATIVE_IMAGE_RECEIPTS=/usr/local/lib/libdeepflare_image_receipts.so
ARG COMMIT_SHA
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 CDS_COMMIT_SHA=${COMMIT_SHA}
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
